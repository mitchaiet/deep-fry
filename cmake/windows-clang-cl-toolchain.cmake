# Build the Windows MSVC ABI with native Clang/LLD and an xwin SDK/CRT tree.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(DEEPFRY_WINDOWS_TOOLS_ROOT "" CACHE PATH "Directory containing compiler wrappers and the Windows SDK")
if(NOT IS_DIRECTORY "${DEEPFRY_WINDOWS_TOOLS_ROOT}/bin")
    message(FATAL_ERROR "Set DEEPFRY_WINDOWS_TOOLS_ROOT to the prepared Windows compiler tools directory.")
endif()
file(REAL_PATH "${DEEPFRY_WINDOWS_TOOLS_ROOT}" DEEPFRY_WINDOWS_TOOLS_ROOT)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES DEEPFRY_WINDOWS_TOOLS_ROOT)
set(CMAKE_C_COMPILER "${DEEPFRY_WINDOWS_TOOLS_ROOT}/bin/clang-cl")
set(CMAKE_CXX_COMPILER "${DEEPFRY_WINDOWS_TOOLS_ROOT}/bin/clang-cl")
set(CMAKE_LINKER "${DEEPFRY_WINDOWS_TOOLS_ROOT}/bin/lld-link")
set(CMAKE_AR "${DEEPFRY_WINDOWS_TOOLS_ROOT}/bin/llvm-lib")
set(CMAKE_RC_COMPILER "${DEEPFRY_WINDOWS_TOOLS_ROOT}/bin/rc")
set(CMAKE_USER_MAKE_RULES_OVERRIDE "${CMAKE_CURRENT_LIST_DIR}/windows-clang-cl-rules.cmake")
set(CMAKE_OSX_ARCHITECTURES "" CACHE STRING "Not used by the Windows target" FORCE)
set(CMAKE_OSX_DEPLOYMENT_TARGET "" CACHE STRING "Not used by the Windows target" FORCE)
set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
set(CMAKE_TRY_COMPILE_CONFIGURATION Release)
set(CMAKE_FIND_ROOT_PATH "${DEEPFRY_WINDOWS_TOOLS_ROOT}/sysroot")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
